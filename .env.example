# "Ask my portfolio" assistant (optional). Without a key the assistant UI is hidden.
# Create a free key at https://console.groq.com and add both in Vercel
# (Project > Settings > Environment Variables). Redeploy after changing them.
GROQ_API_KEY=
# Optional: override the default model (openai/gpt-oss-20b)
GROQ_MODEL=
# Optional: global daily cap on assistant requests (default 800)
ASK_DAILY_CAP=
